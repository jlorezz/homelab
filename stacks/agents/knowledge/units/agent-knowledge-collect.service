[Unit]
Description=Publish evidenced project knowledge and collect review proposals
RequiresMountsFor=/storage/obsidian

[Service]
Type=oneshot
ExecStart=@python@ @runtime@/brain.py collect --spool @state@/proposals --brain /storage/obsidian/Brain
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
ReadWritePaths=/storage/obsidian/Brain/Inbox
ReadWritePaths=/storage/obsidian/Brain/Projects
ReadWritePaths=@state@/evidence
UMask=0002
MemoryMax=128M
CPUQuota=10%
