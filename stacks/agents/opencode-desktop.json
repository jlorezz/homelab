{
  "$schema": "https://opencode.ai/config.json",
  "model": "surplus-intelligence/deepseek-v4.1-flash",
  "providers": {
    "surplus-intelligence": {
      "name": "Surplus Intelligence",
      "env": [
        "SURPLUS_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.surplusintelligence.ai/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "Deepseek v4.1 Flash",
          "modelID": "deepseek-v4.1-flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        }
      }
    }
  }
}
