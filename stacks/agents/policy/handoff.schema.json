{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development task handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "repository", "base_sha", "branch", "scope", "acceptance", "status", "evidence", "next_action"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "repository": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"type": "boolean"},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["proposed", "running", "complete", "blocked"]},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["check", "result"], "properties": {"check": {"type": "string"}, "result": {"enum": ["passed", "failed", "skipped"]}, "artifact": {"type": "string"}, "reason": {"type": "string"}}}},
    "next_action": {"type": "string", "minLength": 1},
    "spend_usd": {"type": ["number", "null"], "minimum": 0}
  }
}
