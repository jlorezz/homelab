[Unit]
Description=Dealpipe production recovery refresh
After=network-online.target dealpipe-testing-ram.service
Wants=network-online.target
Requires=dealpipe-testing-ram.service
RequiresMountsFor=/storage/backups
StartLimitIntervalSec=0
OnFailure=nas-health-check.service
[Service]
Type=oneshot
Restart=on-failure
RestartSec=15m
ExecStopPost=@python@ @failure@ /var/lib/dealpipe-recovery/status.json sanitize-refresh
Environment=PATH=/run/current-system/sw/bin
ExecStart=@python@ /var/lib/agent-platform/bin/workload.py --lock /var/lib/agent-workloads/heavy.lock run --timeout 10800 -- @python@ @source@/refresh.py
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=20G
MemorySwapMax=0
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dealpipe-recovery /storage/backups/dealpipe-encrypted-object-cache /run/dealpipe-recovery-private /var/lib/agent-workloads/heavy.lock
TimeoutStartSec=4h
